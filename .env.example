# No credentials are required for the complete fixture experience.
DATA_PROVIDER=fixture
DATABASE_PATH=data/frag-court.sqlite

# Required in production. Any username works with the shared password.
# Use a long random value and HTTPS. Never commit the real .env.local.
COURT_PASSWORD=

# Optional canonical origin when running behind a reverse proxy.
# APP_ORIGIN=https://court.example.com

# Live HenrikDev integration: read docs/PROVIDERS.md before enabling.
HENRIK_API_KEY=
HENRIK_AUTHORIZED=false
VALORANT_REGION=na
VALORANT_PLATFORM=pc

# Official Riot integration is intentionally not enabled by an API key.
# Production approval + RSO and a permitted use case are required first.
